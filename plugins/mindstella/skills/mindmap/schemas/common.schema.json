{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共通のキー",
  "description": "種類ごとの YAML の項目が共通で持つキー。各種類のスキーマが `$ref` で指す。",
  "$defs": {
    "link": {
      "type": "object",
      "description": "リンク 1 件",
      "required": [
        "title",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "リンクのタイトル"
        },
        "url": {
          "type": "string",
          "description": "リンク先の URL"
        }
      }
    },
    "item": {
      "type": "object",
      "description": "全ての種類の項目が持つキー",
      "required": [
        "id",
        "title",
        "created",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "ID。種類の頭の文字 + `-` + 連番（例 `D-12`）。スクリプトが付ける",
          "pattern": "^[A-Z]-[0-9]+$"
        },
        "title": {
          "type": "string",
          "description": "タイトル",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "description": "対象。設定の `targets[].name` のどれか"
        },
        "category": {
          "type": "string",
          "description": "カテゴリー。設定の `categories[].name` のどれか"
        },
        "phase": {
          "type": "string",
          "description": "フェーズ。設定の `phases` のどれか"
        },
        "tags": {
          "type": "array",
          "description": "タグ（自由な文字列）",
          "items": {
            "type": "string"
          }
        },
        "attrs": {
          "type": "object",
          "description": "自由なキーと値。値は文字列・数値・真偽値。使っているキーの名前は `attrs` のコマンドで引く",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "related": {
          "type": "array",
          "description": "関連する項目の ID。向きを持たず、`impact` はたどらない",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]-[0-9]+$"
          }
        },
        "links": {
          "type": "array",
          "description": "リンク",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "created": {
          "type": "string",
          "description": "作成日時。UTC のタイムゾーン付き ISO 8601。スクリプトが付ける",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"
        },
        "updated": {
          "type": "string",
          "description": "更新日時。UTC のタイムゾーン付き ISO 8601。スクリプトが付ける",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"
        }
      }
    }
  }
}
